# Copy this file to .env.local and adjust. .env.local is never committed.
# These are read on the server only; none of them reach the browser.

# Back-office service address (no trailing slash)
BACKEND_BASE_URL=https://testomnichannelbackend.fidelity.ng

# Authentication service address (no trailing slash)
AUTH_BASE_URL=https://testomnichannelbackend.fidelity.ng

# Channel sent with every sign-in
BACKEND_CHANNEL=BACKOFFICE

# Authentication paths, so a route change is a one-line edit
AUTH_LOGIN_PATH=/api/v1/auth/login
AUTH_OTP_VERIFY_PATH=/api/v1/auth/otp/verify
AUTH_REFRESH_PATH=/api/v1/auth/token/refresh
AUTH_LOGOUT_PATH=/api/v1/auth/logout
AUTH_PASSWORD_CHANGE_PATH=/api/v1/auth/password/change
